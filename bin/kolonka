#!/bin/sh
# kolonka CLI for Git Bash / sh: uses node if available, otherwise Kolonka.exe in node mode
dir=$(cd "$(dirname "$0")" && pwd)
if command -v node >/dev/null 2>&1; then
  exec node "$dir/kolonka.js" "$@"
fi
exe="$dir/../../Kolonka.exe"
[ -f "$exe" ] || { echo "kolonka: node.js or Kolonka.exe is required" >&2; exit 1; }
ELECTRON_RUN_AS_NODE=1 exec "$exe" "$dir/kolonka.js" "$@"
