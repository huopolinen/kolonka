#!/bin/sh
# kolonka CLI for Git Bash / sh: uses node if available, otherwise Kolonka.exe in node mode
dir=$(cd "$(dirname "$0")" && pwd)
if command -v node >/dev/null 2>&1; then
  exec node "$dir/kolonka.js" "$@"
fi
exe="$dir/../../Kolonka.exe"
[ -f "$exe" ] || { echo "kolonka: node.js or Kolonka.exe is required" >&2; exit 1; }
# Kolonka.exe writes UTF-8 bytes; switch the console to UTF-8 for the call so they are not shown
# in the console's own code page (437, 866 ...), and restore it after.
cp=""
if command -v chcp.com >/dev/null 2>&1; then cp=$(chcp.com 2>/dev/null | tr -dc '0-9'); fi
[ -n "$cp" ] && chcp.com 65001 >/dev/null 2>&1
ELECTRON_RUN_AS_NODE=1 "$exe" "$dir/kolonka.js" "$@"
rc=$?
[ -n "$cp" ] && chcp.com "$cp" >/dev/null 2>&1
exit $rc
