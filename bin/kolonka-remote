#!/bin/sh
# kolonka-remote: control the Kolonka terminal (Windows) from a server you are connected to over ssh.
# Installed on the server as ~/.local/bin/kolonka by `kolonka remote install HOST`; needs only sh,
# printf and base64. It prints OSC 7711 sequences to the terminal (README: "Remote control over SSH").
# In any terminal other than Kolonka it prints nothing and exits with 3, unless --force is given.

usage() {
  cat <<'EOF'
kolonka (remote) — control Kolonka from a server over ssh

  kolonka open [--same | --host HOST] [--name N] [--ws W] [--no-select] [--here] [--] [CMD...]
        open a Kolonka tab connected to this server (--same, the default) or to HOST, running CMD
        (a login shell without CMD); --here starts it in the current directory
  kolonka status idle|active|blocked|done
        the status of this tab (blocked = needs you)
  kolonka notify TEXT... [--title T]
        a notification; clicking it switches to this tab
  kolonka rename NAME...
        rename this tab

Options for every command: --force sends even if LC_TERMINAL is not Kolonka.
Exit codes: 0 sent, 2 usage error, 3 not running in Kolonka (nothing sent).
EOF
}

die() { printf 'kolonka: %s\n' "$1" >&2; exit 2; }

b64() { printf '%s' "$1" | base64 | tr -d '\r\n'; }

# Kolonka sets LC_TERMINAL in every tab; ssh passes it with SendEnv / AcceptEnv. Inside tmux the
# variable of the pane can be stale, so the current client's one is asked too.
is_kolonka() {
  [ "${LC_TERMINAL:-}" = Kolonka ] && return 0
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    case "$(tmux show-environment LC_TERMINAL 2>/dev/null)" in LC_TERMINAL=Kolonka) return 0 ;; esac
  fi
  return 1
}

# $1: the payload after "7711;". Under tmux the sequence is wrapped in a DCS passthrough
# (set -g allow-passthrough on). Written to the terminal itself, so it works with stdout redirected.
emit() {
  if [ -n "${TMUX:-}" ]; then
    seq=$(printf '\033Ptmux;\033\033]7711;%s\007\033\\' "$1")
  else
    seq=$(printf '\033]7711;%s\007' "$1")
  fi
  tty=${KOLONKA_TTY:-/dev/tty}
  if (: >> "$tty") 2>/dev/null; then printf '%s' "$seq" >> "$tty"; else printf '%s' "$seq"; fi
}

force=
while [ $# -gt 0 ]; do
  case "$1" in
    --force) force=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    --version|version) echo 'kolonka-remote 1'; exit 0 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { usage >&2; exit 2; }
sub=$1; shift

case "$sub" in
  open)
    host=@same; name=; ws=; select=1; here=
    while [ $# -gt 0 ]; do
      case "$1" in
        --same) host=@same ;;
        --host) [ $# -ge 2 ] || die '--host needs a value'; host=$2; shift ;;
        --host=*) host=${1#--host=} ;;
        --name) [ $# -ge 2 ] || die '--name needs a value'; name=$2; shift ;;
        --name=*) name=${1#--name=} ;;
        --ws) [ $# -ge 2 ] || die '--ws needs a value'; ws=$2; shift ;;
        --ws=*) ws=${1#--ws=} ;;
        --no-select) select=0 ;;
        --here) here=1 ;;
        --force) force=1 ;;
        --) shift; break ;;
        -*) die "unknown option $1 (put the command after --)" ;;
        *) break ;;
      esac
      shift
    done
    case "$host" in ''|-*) die "not a valid host: $host" ;; esac
    cmd="$*"
    if [ -n "$here" ]; then
      dir=$(printf '%s' "$PWD" | sed "s/'/'\\\\''/g")
      if [ -n "$cmd" ]; then cmd="cd '$dir' && $cmd"; else cmd="cd '$dir' && exec \"\${SHELL:-sh}\" -l"; fi
    fi
    payload="open;host=$(b64 "$host");cmd=$(b64 "$cmd")"
    [ -n "$name" ] && payload="$payload;name=$(b64 "$name")"
    [ -n "$ws" ] && payload="$payload;ws=$(b64 "$ws")"
    payload="$payload;select=$select"
    ;;
  status)
    [ "${1:-}" = --force ] && { force=1; shift; }
    [ $# -eq 1 ] || die 'status idle|active|blocked|done'
    case "$1" in idle|active|blocked|done) ;; *) die "unknown status: $1" ;; esac
    payload="status;state=$1"
    ;;
  notify)
    title=; text=
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) [ $# -ge 2 ] || die '--title needs a value'; title=$2; shift ;;
        --title=*) title=${1#--title=} ;;
        --force) force=1 ;;
        --) shift; text="${text:+$text }$*"; break ;;
        *) text="${text:+$text }$1" ;;
      esac
      shift
    done
    [ -n "$text$title" ] || die 'notify TEXT [--title T]'
    payload="notify;title=$(b64 "$title");text=$(b64 "$text")"
    ;;
  rename)
    [ "${1:-}" = --force ] && { force=1; shift; }
    [ $# -gt 0 ] || die 'rename NAME'
    payload="rename;name=$(b64 "$*")"
    ;;
  *) die "unknown command: $sub (open, status, notify, rename)" ;;
esac

if [ -z "$force" ] && ! is_kolonka; then exit 3; fi
emit "$payload"
