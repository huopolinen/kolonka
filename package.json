{
  "name": "kolonka",
  "productName": "Kolonka",
  "version": "0.2.0",
  "description": "A Windows terminal with vertical tabs, workspaces, hold-to-talk voice input and a full control API for scripts and coding agents",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "set KOLONKA_DEBUG=1&& electron .",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node test/smoke/packaged.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "license": "MIT",
  "author": "huopolinen",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.kolonka.terminal",
    "productName": "Kolonka",
    "copyright": "Copyright © 2026 huopolinen. MIT License",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "!**/*.map",
      "!**/*.test.js",
      "!**/*.pdb",
      "!node_modules/node-pty/{src,deps,scripts,third_party,typings,binding.gyp}",
      "!node_modules/node-pty/build/Release/conpty/**",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**",
      "!node_modules/node-pty/prebuilds/win32-x64/{conpty/**,pty.node,winpty.dll,winpty-agent.exe}",
      "!node_modules/node-addon-api/**",
      "!node_modules/@xterm/*/{src,typings}/**",
      "!node_modules/**/*.mjs",
      "!node_modules/**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "executableName": "Kolonka"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kolonka",
      "artifactName": "Kolonka-Setup-${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "homepage": "https://github.com/huopolinen/kolonka",
  "repository": {
    "type": "git",
    "url": "https://github.com/huopolinen/kolonka.git"
  },
  "bugs": {
    "url": "https://github.com/huopolinen/kolonka/issues"
  },
  "keywords": [
    "terminal",
    "windows",
    "vertical-tabs",
    "claude-code",
    "ai-agents",
    "xterm",
    "conpty",
    "voice-input",
    "whisper"
  ]
}
